{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"rizn-website",
 "main":"server/cloudflare.mjs",
 "compatibility_date":"2026-10-14",
 "workers_dev":true,
 "preview_urls":false,
 "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":true},
